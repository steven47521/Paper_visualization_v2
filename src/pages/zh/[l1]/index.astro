---
import Layout from '../../../layouts/Layout.astro';
import { getLocalizedPath, t } from '../../../i18n/translations';
import { getCollection } from 'astro:content';
import BenchmarkCardGrid from '../../../components/BenchmarkCardGrid.astro';

const locale = 'zh';

export async function getStaticPaths() {
  const taxonomy = await getCollection('taxonomy');
  return taxonomy.map(entry => ({
    params: { l1: entry.data.id },
    props: { taxonomy: entry },
  }));
}

const { taxonomy: taxEntry } = Astro.props;
const benchmarks = await getCollection('benchmarks');
const scores = await getCollection('scores');

function summarizeText(text: string | undefined, fallback: string) {
  const normalized = (text || fallback).replace(/\s+/g, ' ').trim();
  if (normalized.length <= 170) return normalized;
  return `${normalized.slice(0, 167).trimEnd()}...`;
}

const subcategoryTabs = taxEntry.data.subcategories.map(sub => {
  const benchmarkCards = sub.benchmarks
    .map(bId => {
      const bDef = benchmarks.find(b => b.data.id === bId);
      const sData = scores.find(s => s.data.benchmark_id === bId);
      if (!bDef) return null;

      const resourceLabels = [
        ...(bDef.data.resources ?? []).map(item => item.label_zh),
        ...(bDef.data.paper ? ['Paper'] : []),
        ...(!bDef.data.resources?.some(item => item.url === bDef.data.url) && bDef.data.url
          ? [bDef.data.url.includes('github.com') ? 'Code' : 'Project']
          : []),
      ].slice(0, 3);

      return {
        id: bId,
        name: bDef.data.name_zh,
        description: bDef.data.description_zh,
        snippet: summarizeText(bDef.data.overview_zh, bDef.data.description_zh),
        primaryMetric: bDef.data.metrics[0]?.name,
        focus: bDef.data.glance?.[0]?.value,
        modelCount: sData?.data.results.length ?? 0,
        resourceLabels,
        updated: sData?.data.updated,
      };
    })
    .filter(Boolean);

  return {
    id: sub.id,
    name_zh: sub.name_zh,
    name_en: sub.name_en,
    description_zh: sub.description_zh,
    description_en: sub.description_en,
    benchmarkCards,
  };
});
---

<Layout title={taxEntry.data.name_zh}>
  <nav class="mb-6 text-sm text-[var(--color-text-secondary)]">
    <a href={getLocalizedPath('/', locale)} class="hover:text-[var(--color-primary)]">{t(locale, 'nav_home')}</a>
    <span class="mx-2">/</span>
    <span>{taxEntry.data.name_zh}</span>
  </nav>

  <div class="mb-8">
    <div class="flex items-center gap-3 mb-2">
      <span class="w-4 h-4 rounded-full" style={`background-color: ${taxEntry.data.color}`}></span>
      <h1 class="text-3xl font-bold">{taxEntry.data.name_zh}</h1>
    </div>
  </div>

  <!-- Subcategory Tabs -->
  <div class="mb-6 border-b border-[var(--color-border)]">
    <div class="flex gap-1 overflow-x-auto">
      {subcategoryTabs.map((tab, i) => (
        <button
          class="subcategory-tab px-4 py-2.5 text-sm font-medium whitespace-nowrap border-b-2 transition-colors"
          data-tab={tab.id}
          data-active={i === 0 ? 'true' : 'false'}
        >
          {tab.name_zh}
        </button>
      ))}
    </div>
  </div>

  <!-- Tab Contents -->
  {subcategoryTabs.map((tab, i) => (
    <div
      class="subcategory-content"
      data-tab-content={tab.id}
      style={i === 0 ? '' : 'display:none'}
    >
      <BenchmarkCardGrid
        locale={locale}
        l1Id={taxEntry.data.id}
        accentColor={taxEntry.data.color}
        sectionName={tab.name_zh}
        sectionDescription={tab.description_zh}
        items={tab.benchmarkCards}
      />
    </div>
  ))}

  <script is:inline>
    document.querySelectorAll('.subcategory-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        const tabId = tab.getAttribute('data-tab');
        document.querySelectorAll('.subcategory-tab').forEach(t => {
          t.setAttribute('data-active', 'false');
          t.style.borderBottomColor = 'transparent';
          t.style.color = '';
        });
        tab.setAttribute('data-active', 'true');
        tab.style.borderBottomColor = 'var(--color-primary)';
        tab.style.color = 'var(--color-primary)';

        document.querySelectorAll('.subcategory-content').forEach(c => {
          c.style.display = c.getAttribute('data-tab-content') === tabId ? '' : 'none';
        });
      });

      // Initial styling
      if (tab.getAttribute('data-active') === 'true') {
        tab.style.borderBottomColor = 'var(--color-primary)';
        tab.style.color = 'var(--color-primary)';
      } else {
        tab.style.borderBottomColor = 'transparent';
      }
    });
  </script>
</Layout>
