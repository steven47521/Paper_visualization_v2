---
import Layout from '../../../layouts/Layout.astro';
import { getLocalizedPath, t } from '../../../i18n/translations';
import { getCollection } from 'astro:content';
import { buildBenchmarkDetailData, getModelsArray } from '../../../lib/data';
import LeaderboardTable from '../../../components/LeaderboardTable';
import SampleViewer from '../../../components/SampleViewer';

const locale = 'zh';

export async function getStaticPaths() {
  const taxonomy = await getCollection('taxonomy');
  const benchmarksCol = await getCollection('benchmarks');

  const paths = [];
  for (const tax of taxonomy) {
    for (const sub of tax.data.subcategories) {
      for (const benchId of sub.benchmarks) {
        const bench = benchmarksCol.find(b => b.data.id === benchId);
        if (bench) {
          paths.push({
            params: { l1: tax.data.id, benchmark: benchId },
            props: { taxonomy: tax, benchmark: bench, subcategory: sub },
          });
        }
      }
    }
  }
  return paths;
}

const { taxonomy: taxEntry, benchmark, subcategory } = Astro.props;
const scores = await getCollection('scores');
const modelsCollection = await getCollection('models');
const models = getModelsArray(modelsCollection);
const modelsList = models.map(m => ({ id: m.id, name: m.name, org: m.org, color: m.color }));

const scoreEntry = scores.find(s => s.data.benchmark_id === benchmark.data.id);
const detail = buildBenchmarkDetailData(benchmark, scoreEntry, modelsList, locale);

const columns = [
  { key: 'model_name', label: t(locale, 'model'), sortable: false },
  ...detail.metrics.map(m => ({ key: `score_${m.id}`, label: m.name })),
  { key: 'source', label: 'Source', sortable: false },
  { key: 'date', label: 'Date', sortable: false },
];

const rows = detail.leaderboardRows
  .sort((a, b) => {
    const m = detail.metrics[0];
    if (!m) return 0;
    const diff = (b.scores[m.id] ?? 0) - (a.scores[m.id] ?? 0);
    return m.higher_is_better ? diff : -diff;
  })
  .map(r => ({
    model_id: r.model_id,
    model_name: r.model_name,
    org: r.org,
    color: r.color,
    ...Object.fromEntries(Object.entries(r.scores).map(([k, v]) => [`score_${k}`, v])),
    source: r.source,
    date: r.date || '-',
  }));

const overviewParagraphs = (detail.overview ?? detail.description)
  .split('\n')
  .map((line: string) => line.trim())
  .filter(Boolean);

const statChips = [
  {
    label: '所属二级目录',
    value: subcategory.name_zh,
  },
  detail.metrics[0]
    ? {
        label: '主榜指标',
        value: detail.metrics[0].name,
      }
    : null,
  {
    label: '上榜模型',
    value: String(rows.length),
  },
  detail.updated
    ? {
        label: '数据更新',
        value: detail.updated,
      }
    : null,
].filter(Boolean);
---

<Layout title={detail.name}>
  <nav class="mb-6 text-sm text-[var(--color-text-secondary)]">
    <a href={getLocalizedPath('/', locale)} class="hover:text-[var(--color-primary)]">{t(locale, 'nav_home')}</a>
    <span class="mx-2">/</span>
    <a href={getLocalizedPath(`/${taxEntry.data.id}/`, locale)} class="hover:text-[var(--color-primary)]">{taxEntry.data.name_zh}</a>
    <span class="mx-2">/</span>
    <span>{subcategory.name_zh}</span>
    <span class="mx-2">/</span>
    <span>{benchmark.data.name}</span>
  </nav>

  <section class="mb-8 overflow-hidden rounded-[26px] border border-[var(--color-border)] bg-[var(--color-bg-card)]">
    <div class="relative p-6 md:p-8">
      <div
        class="pointer-events-none absolute inset-x-0 top-0 h-1.5"
        style={`background: linear-gradient(90deg, ${taxEntry.data.color}, transparent 78%)`}
      ></div>
      <div
        class="pointer-events-none absolute -right-10 top-0 h-44 w-44 rounded-full blur-3xl"
        style={`background: radial-gradient(circle, ${taxEntry.data.color}24 0%, transparent 72%)`}
      ></div>

      <div class="relative space-y-5">
        <div class="space-y-3">
          <p class="text-[11px] font-semibold uppercase tracking-[0.3em] text-[var(--color-text-secondary)]">
            Benchmark Work
          </p>
          <h1 class="max-w-4xl text-3xl font-semibold tracking-tight md:text-4xl">{detail.name}</h1>
          <p class="max-w-4xl text-base leading-8 text-[var(--color-text-secondary)]">
            {detail.description}
          </p>
        </div>

        <div class="flex flex-wrap gap-3">
          {detail.url && (
            <a
              href={detail.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 rounded-full bg-[var(--color-primary)] px-4 py-2 text-sm font-medium text-white transition-opacity hover:opacity-90"
            >
              {t(locale, 'official_link')} ↗
            </a>
          )}
          {detail.paper && (
            <a
              href={detail.paper}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 rounded-full border border-[var(--color-border)] px-4 py-2 text-sm font-medium transition-colors hover:border-[var(--color-primary)] hover:text-[var(--color-primary)]"
            >
              Paper ↗
            </a>
          )}
        </div>

        <div class="flex flex-wrap gap-2">
          {statChips.map(chip => (
            <span class="rounded-full bg-[var(--color-bg)] px-3 py-1.5 text-xs text-[var(--color-text-secondary)]">
              {chip.label}: {chip.value}
            </span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <div class="grid gap-8 xl:grid-cols-[minmax(0,1.65fr)_minmax(280px,0.85fr)]">
    <div class="space-y-8">
      <section class="rounded-[24px] border border-[var(--color-border)] bg-[var(--color-bg-card)] p-5 md:p-6">
        <div class="mb-5 flex flex-col gap-2 md:flex-row md:items-end md:justify-between">
          <div>
            <p class="text-[11px] font-semibold uppercase tracking-[0.28em] text-[var(--color-text-secondary)]">
              Main Leaderboard
            </p>
            <h2 class="mt-2 text-2xl font-semibold">{t(locale, 'leaderboard')}</h2>
          </div>
          {detail.leaderboardNote && (
            <p class="max-w-xl text-sm leading-7 text-[var(--color-text-secondary)]">
              {detail.leaderboardNote}
            </p>
          )}
        </div>

        <LeaderboardTable
          client:visible
          columns={columns}
          rows={rows}
          searchPlaceholder={t(locale, 'search_placeholder')}
          sourceLabels={{
            official: t(locale, 'source_official'),
            community: t(locale, 'source_community'),
            self_reported: t(locale, 'source_self_reported'),
          }}
          highlightMax
          highlightMode={detail.metrics[0]?.higher_is_better ? 'max' : 'min'}
          emptyLabel={t(locale, 'no_results')}
        />
      </section>

      <section class="rounded-[24px] border border-[var(--color-border)] bg-[var(--color-bg-card)] p-5 md:p-6">
        <p class="text-[11px] font-semibold uppercase tracking-[0.28em] text-[var(--color-text-secondary)]">
          Paper Insight
        </p>
        <h2 class="mt-2 mb-5 text-2xl font-semibold">工作细节</h2>
        <div class="space-y-4">
          {overviewParagraphs.map(line => (
            <p class="text-sm leading-8 text-[var(--color-text-secondary)]">{line}</p>
          ))}
        </div>

        {detail.highlights && detail.highlights.length > 0 && (
          <div class="mt-6 grid gap-3 md:grid-cols-2">
            {detail.highlights.map(item => (
              <div class="rounded-2xl border border-[var(--color-border)]/80 bg-[var(--color-bg)] p-4">
                <p class="text-sm leading-7 text-[var(--color-text-secondary)]">{item}</p>
              </div>
            ))}
          </div>
        )}
      </section>

      <section class="rounded-[24px] border border-[var(--color-border)] bg-[var(--color-bg-card)] p-5 md:p-6">
        <p class="text-[11px] font-semibold uppercase tracking-[0.28em] text-[var(--color-text-secondary)]">
          Evaluation Setup
        </p>
        <h2 class="mt-2 mb-5 text-2xl font-semibold">{t(locale, 'metrics_desc')}</h2>
        <div class="grid gap-4 md:grid-cols-2">
          {detail.metrics.map(m => (
            <div class="rounded-2xl border border-[var(--color-border)]/80 bg-[var(--color-bg)] p-4">
              <div class="flex items-start justify-between gap-3">
                <div>
                  <h3 class="text-lg font-semibold">{m.name}</h3>
                  <p class="mt-2 text-sm leading-7 text-[var(--color-text-secondary)]">
                    {m.description || '-'}
                  </p>
                </div>
                <span class={`shrink-0 rounded-full px-3 py-1 text-xs ${m.higher_is_better ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700'}`}>
                  {m.higher_is_better ? t(locale, 'higher_better') : t(locale, 'lower_better')}
                </span>
              </div>
              <div class="mt-4 text-xs uppercase tracking-[0.16em] text-[var(--color-text-secondary)]">
                {t(locale, 'score_range')}: {m.range ? `[${m.range[0]}, ${m.range[1]}]` : '-'}
              </div>
            </div>
          ))}
        </div>
      </section>

      {detail.samples && detail.samples.length > 0 && (
        <section class="rounded-[24px] border border-[var(--color-border)] bg-[var(--color-bg-card)] p-5 md:p-6">
          <p class="text-[11px] font-semibold uppercase tracking-[0.28em] text-[var(--color-text-secondary)]">
            Example Data
          </p>
          <h2 class="mt-2 mb-5 text-2xl font-semibold">{t(locale, 'data_samples')}</h2>
          <SampleViewer
            client:visible
            samples={detail.samples}
            locale={locale}
            inputLabel={t(locale, 'input')}
            outputLabel={t(locale, 'output')}
            explanationLabel={t(locale, 'explanation')}
          />
        </section>
      )}
    </div>

    <aside class="space-y-6">
      {detail.glance && detail.glance.length > 0 && (
        <section class="rounded-[22px] border border-[var(--color-border)] bg-[var(--color-bg-card)] p-5">
          <p class="text-[11px] font-semibold uppercase tracking-[0.28em] text-[var(--color-text-secondary)]">
            Quick Facts
          </p>
          <h2 class="mt-2 mb-4 text-xl font-semibold">{t(locale, 'glance')}</h2>
          <div class="space-y-3">
            {detail.glance.map(item => (
              <div class="rounded-2xl bg-[var(--color-bg)] px-4 py-3">
                <div class="text-xs uppercase tracking-[0.14em] text-[var(--color-text-secondary)]">
                  {item.label}
                </div>
                <div class="mt-1 text-sm font-medium leading-6">{item.value}</div>
              </div>
            ))}
          </div>
        </section>
      )}

      {detail.resources && detail.resources.length > 0 && (
        <section class="rounded-[22px] border border-[var(--color-border)] bg-[var(--color-bg-card)] p-5">
          <p class="text-[11px] font-semibold uppercase tracking-[0.28em] text-[var(--color-text-secondary)]">
            Links
          </p>
          <h2 class="mt-2 mb-4 text-xl font-semibold">{t(locale, 'resources')}</h2>
          <div class="space-y-3">
            {detail.resources.map(item => (
              <a
                href={item.url}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-between rounded-2xl border border-[var(--color-border)]/80 px-4 py-3 text-sm transition-colors hover:border-[var(--color-primary)] hover:text-[var(--color-primary)]"
              >
                <span>{item.label}</span>
                <span>↗</span>
              </a>
            ))}
          </div>
        </section>
      )}

      {detail.downloads && detail.downloads.length > 0 && (
        <section class="rounded-[22px] border border-[var(--color-border)] bg-[var(--color-bg-card)] p-5">
          <p class="text-[11px] font-semibold uppercase tracking-[0.28em] text-[var(--color-text-secondary)]">
            Assets
          </p>
          <h2 class="mt-2 mb-4 text-xl font-semibold">{t(locale, 'downloads')}</h2>
          <div class="space-y-3">
            {detail.downloads.map(item => (
              <div class="rounded-2xl border border-[var(--color-border)]/80 px-4 py-3">
                <a
                  href={item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center justify-between text-sm font-medium transition-colors hover:text-[var(--color-primary)]"
                >
                  <span>{item.label}</span>
                  <span>↗</span>
                </a>
                {item.note && (
                  <p class="mt-2 text-xs leading-6 text-[var(--color-text-secondary)]">{item.note}</p>
                )}
              </div>
            ))}
          </div>
        </section>
      )}
    </aside>
  </div>

  <div class="mt-8">
    <a
      href={getLocalizedPath(`/${taxEntry.data.id}/`, locale)}
      class="text-sm text-[var(--color-primary)] hover:underline"
    >
      &larr; {t(locale, 'back_to_category')}
    </a>
  </div>
</Layout>
