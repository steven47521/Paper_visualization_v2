---
import Layout from '../../../layouts/Layout.astro';
import { getLocalizedPath, t, withBase } from '../../../i18n/translations';
import { getCollection } from 'astro:content';
import { buildBenchmarkDetailData, getModelsArray } from '../../../lib/data';
import LeaderboardTable from '../../../components/LeaderboardTable';
import SampleViewer from '../../../components/SampleViewer';
import BenchmarkFigureStrip from '../../../components/BenchmarkFigureStrip';

const locale = 'en';

export async function getStaticPaths() {
  const taxonomy = await getCollection('taxonomy');
  const benchmarksCol = await getCollection('benchmarks');

  const paths = [];
  for (const tax of taxonomy) {
    for (const sub of tax.data.subcategories) {
      for (const benchId of sub.benchmarks) {
        const bench = benchmarksCol.find(b => b.data.id === benchId);
        if (bench) {
          paths.push({
            params: { l1: tax.data.id, benchmark: benchId },
            props: { taxonomy: tax, benchmark: bench, subcategory: sub },
          });
        }
      }
    }
  }
  return paths;
}

function splitParas(text: string | undefined): string[] {
  if (!text?.trim()) return [];
  return text.split('\n').map(l => l.trim()).filter(Boolean);
}

const { taxonomy: taxEntry, benchmark, subcategory } = Astro.props;
const scores = await getCollection('scores');
const modelsCollection = await getCollection('models');
const models = getModelsArray(modelsCollection);
const modelsList = models.map(m => ({ id: m.id, name: m.name, org: m.org, color: m.color }));

const scoreEntry = scores.find(s => s.data.benchmark_id === benchmark.data.id);
const detail = buildBenchmarkDetailData(benchmark, scoreEntry, modelsList, locale);

const columns = [
  { key: 'model_name', label: t(locale, 'model'), sortable: false },
  ...detail.metrics.map(m => ({ key: `score_${m.id}`, label: m.name })),
  { key: 'source', label: t(locale, 'benchmark_col_source'), sortable: false },
  { key: 'date', label: t(locale, 'benchmark_col_date'), sortable: false },
];

const rows = detail.leaderboardRows
  .sort((a, b) => {
    const m = detail.metrics[0];
    if (!m) return 0;
    const diff = (b.scores[m.id] ?? 0) - (a.scores[m.id] ?? 0);
    return m.higher_is_better ? diff : -diff;
  })
  .map(r => ({
    model_id: r.model_id,
    model_name: r.model_name,
    org: r.org,
    color: r.color,
    ...Object.fromEntries(Object.entries(r.scores).map(([k, v]) => [`score_${k}`, v])),
    source: r.source,
    date: r.date || '-',
  }));

const abstractParas = splitParas(detail.abstract);
const overviewParas = splitParas(detail.overview);
const methodParas = splitParas(detail.method);
const highlights = detail.highlights ?? [];
const extraResources = detail.resources.filter(
  r => r.url !== detail.url && (!detail.paper || r.url !== detail.paper)
);

const showMethodBlock =
  overviewParas.length > 0 || methodParas.length > 0 || detail.metrics.length > 0;
const allFigureStripItems = [...detail.figures, ...detail.chartFigures].map((f, i) => ({
  src: withBase(f.image),
  caption: f.caption?.trim() || `${t(locale, 'benchmark_figure_fallback_title')} ${i + 1}`,
}));
const showFigureStrip = allFigureStripItems.length > 0;
---

<Layout title={detail.name} benchmarkDetail>
  <article class="benchmark-article space-y-14 sm:space-y-16">
    <nav class="benchmark-breadcrumb mb-2" aria-label="Breadcrumb">
      <a href={getLocalizedPath('/', locale)} class="transition-colors hover:text-[var(--color-primary)]">{t(locale, 'nav_home')}</a>
      <span class="mx-2 opacity-50">/</span>
      <a href={getLocalizedPath(`/${taxEntry.data.id}/`, locale)} class="transition-colors hover:text-[var(--color-primary)]">{taxEntry.data.name_en}</a>
      <span class="mx-2 opacity-50">/</span>
      <a
        href={getLocalizedPath(`/${taxEntry.data.id}/?tab=${encodeURIComponent(subcategory.id)}`, locale)}
        class="transition-colors hover:text-[var(--color-primary)]"
      >
        {subcategory.name_en}
      </a>
      <span class="mx-2 opacity-50">/</span>
      <span class="text-[var(--color-text)]">{benchmark.data.name}</span>
    </nav>

    <header class="w-full max-w-none">
      <p class="benchmark-section-eyebrow">{t(locale, 'benchmark_eyebrow')}</p>
      <h1 class="benchmark-header-title text-[clamp(2rem,4.5vw,3rem)] font-bold">{detail.name}</h1>
      <p class="mt-4 max-w-none text-base leading-relaxed text-[var(--color-text-secondary)]">{detail.description}</p>

      <div class="benchmark-meta-bar">
        <span><span class="opacity-80">{t(locale, 'benchmark_meta_subcategory')}:</span> {subcategory.name_en}</span>
        {
          detail.metrics[0] && (
            <span>
              <span class="opacity-80">{t(locale, 'benchmark_meta_primary_metric')}:</span> {detail.metrics[0].name}
            </span>
          )
        }
        {detail.updated && <span><span class="opacity-80">{t(locale, 'benchmark_meta_data_updated')}:</span> {detail.updated}</span>}
        <span><span class="opacity-80">{t(locale, 'benchmark_meta_model_count')}:</span> {rows.length}</span>
      </div>
      {
        detail.authors && (
          <p class="benchmark-authors">
            <span class="opacity-80">{t(locale, 'benchmark_authors')}:</span> {detail.authors}
          </p>
        )
      }

      <div class="benchmark-actions">
        <a
          href={detail.url}
          target="_blank"
          rel="noopener noreferrer"
          class="benchmark-action-btn benchmark-action-btn--primary"
        >
          {t(locale, 'benchmark_action_code_site')} ↗
        </a>
        {
          detail.paper && (
            <a href={detail.paper} target="_blank" rel="noopener noreferrer" class="benchmark-action-btn">
              {t(locale, 'benchmark_action_paper')} ↗
            </a>
          )
        }
      </div>
    </header>

    <section class="benchmark-abstract" aria-labelledby="bench-abstract-heading">
      <h2 id="bench-abstract-heading" class="benchmark-section-heading text-left text-[1.35rem]">
        {t(locale, 'benchmark_section_abstract')}
      </h2>
      <div class="benchmark-abstract-inner benchmark-prose mt-8 text-left">
        {abstractParas.map(p => (
          <p>{p}</p>
        ))}
      </div>
    </section>

    {
      highlights.length > 0 && (
        <section class="w-full max-w-none" aria-labelledby="bench-contrib-heading">
          <h2 id="bench-contrib-heading" class="benchmark-section-heading">
            {t(locale, 'benchmark_section_contributions')}
          </h2>
          <ul class="benchmark-contrib-list mt-4 text-[1.05rem]">
            {highlights.map(item => (
              <li>{item}</li>
            ))}
          </ul>
        </section>
      )
    }

    {
      showMethodBlock && (
        <section class="space-y-10" aria-labelledby="bench-method-heading">
          <div class="w-full max-w-none">
            <h2 id="bench-method-heading" class="benchmark-section-heading text-left">{t(locale, 'benchmark_section_method')}</h2>
          </div>

          <div class="benchmark-card-surface w-full max-w-none space-y-10">
            {(overviewParas.length > 0 || methodParas.length > 0) && (
              <div class="space-y-8 benchmark-prose text-[1.02rem] leading-[1.82] text-left max-w-none">
                {
                  overviewParas.length > 0 && (
                    <div>
                      {methodParas.length > 0 && <h3 class="benchmark-subblock-title">{t(locale, 'benchmark_section_overview')}</h3>}
                      {overviewParas.map(p => (
                        <p>{p}</p>
                      ))}
                    </div>
                  )
                }
                {
                  methodParas.length > 0 && (
                    <div>
                      {overviewParas.length > 0 && <h3 class="benchmark-subblock-title">{t(locale, 'benchmark_subsection_method')}</h3>}
                      {methodParas.map(p => (
                        <p>{p}</p>
                      ))}
                    </div>
                  )
                }
              </div>
            )}

            {
              detail.metrics.length > 0 && (
                <div>
                  <h3 class="benchmark-subblock-title mb-4">{t(locale, 'metrics_desc')}</h3>
                  <div class="grid gap-4 sm:grid-cols-2">
                    {detail.metrics.map(m => (
                      <div class="benchmark-metric-row">
                        <div class="flex flex-wrap items-start justify-between gap-2">
                          <h4 class="text-base font-semibold text-[var(--color-text)]">{m.name}</h4>
                          <span class="benchmark-metric-badge">{m.higher_is_better ? t(locale, 'higher_better') : t(locale, 'lower_better')}</span>
                        </div>
                        {m.description && <p class="mt-2 text-sm leading-relaxed text-[var(--color-text-secondary)]">{m.description}</p>}
                        <p class="mt-3 text-xs text-[var(--color-text-secondary)]">
                          {t(locale, 'score_range')}: {m.range ? `[${m.range[0]}, ${m.range[1]}]` : '—'}
                        </p>
                      </div>
                    ))}
                  </div>
                </div>
              )
            }
          </div>
        </section>
      )
    }

    {
      showFigureStrip && (
        <section class="w-full max-w-none space-y-4" aria-labelledby="bench-figures-heading">
          <h2 id="bench-figures-heading" class="benchmark-section-heading text-left">
            {t(locale, 'benchmark_section_charts')}
          </h2>
          <div class="benchmark-card-surface w-full max-w-none">
            <BenchmarkFigureStrip
              client:visible
              figures={allFigureStripItems}
              prevLabel={t(locale, 'benchmark_figure_strip_prev')}
              nextLabel={t(locale, 'benchmark_figure_strip_next')}
              goToSlideLabel={t(locale, 'benchmark_figure_strip_go_to')}
              regionLabel={t(locale, 'benchmark_section_charts')}
            />
          </div>
        </section>
      )
    }

    <section class="benchmark-card-surface benchmark-leaderboard-card w-full max-w-none" aria-labelledby="bench-lb-heading">
      <div class="mb-6 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
        <div>
          <h2 id="bench-lb-heading" class="benchmark-section-heading mb-0">{t(locale, 'benchmark_section_leaderboard')}</h2>
        </div>
        {detail.leaderboardNote && <p class="max-w-xl text-sm leading-relaxed text-[var(--color-text-secondary)]">{detail.leaderboardNote}</p>}
      </div>

      <LeaderboardTable
        client:visible
        columns={columns}
        rows={rows}
        searchPlaceholder={t(locale, 'search_placeholder')}
        sourceLabels={{
          official: t(locale, 'source_official'),
          community: t(locale, 'source_community'),
          self_reported: t(locale, 'source_self_reported'),
        }}
        highlightMax
        highlightMode={detail.metrics[0]?.higher_is_better ? 'max' : 'min'}
        emptyLabel={t(locale, 'no_results')}
        locale={locale}
        className="leaderboard-table--editorial"
      />
    </section>

    {
      detail.samples && detail.samples.length > 0 && (
        <section class="benchmark-card-surface w-full max-w-none" aria-labelledby="bench-samples-heading">
          <h2 id="bench-samples-heading" class="benchmark-section-heading text-left">{t(locale, 'data_samples')}</h2>
          <div class="mt-6">
            <SampleViewer
              client:visible
              samples={detail.samples}
              locale={locale}
              inputLabel={t(locale, 'input')}
              outputLabel={t(locale, 'output')}
              explanationLabel={t(locale, 'explanation')}
            />
          </div>
        </section>
      )
    }

    <div class="grid w-full max-w-none gap-8 xl:grid-cols-[minmax(0,1fr)_minmax(260px,0.4fr)] xl:gap-12">
      <div class="space-y-6">
        {
          detail.glance && detail.glance.length > 0 && (
            <section class="benchmark-card-surface" aria-labelledby="bench-glance-heading">
              <h2 id="bench-glance-heading" class="benchmark-section-heading text-xl">{t(locale, 'glance')}</h2>
              <dl class="mt-4 space-y-4">
                {detail.glance.map(item => (
                  <div class="border-b border-[var(--color-border)]/70 pb-4 last:border-0 last:pb-0">
                    <dt class="text-xs font-semibold uppercase tracking-wider text-[var(--color-text-secondary)]">{item.label}</dt>
                    <dd class="mt-1 text-sm leading-relaxed text-[var(--color-text)]">{item.value}</dd>
                  </div>
                ))}
              </dl>
            </section>
          )
        }
      </div>

      <aside class="space-y-6">
        {
          extraResources.length > 0 && (
            <section class="benchmark-card-surface" aria-labelledby="bench-res-heading">
              <h2 id="bench-res-heading" class="benchmark-section-heading text-xl">{t(locale, 'resources')}</h2>
              <ul class="mt-4 space-y-2">
                {extraResources.map(item => (
                  <li>
                    <a
                      href={item.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="benchmark-action-btn w-full justify-between text-sm"
                    >
                      {item.label}
                      <span aria-hidden="true">↗</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          detail.downloads && detail.downloads.length > 0 && (
            <section class="benchmark-card-surface" aria-labelledby="bench-dl-heading">
              <h2 id="bench-dl-heading" class="benchmark-section-heading text-xl">{t(locale, 'downloads')}</h2>
              <ul class="mt-4 space-y-3">
                {detail.downloads.map(item => (
                  <li class="rounded-md border border-[var(--color-border)] px-3 py-2">
                    <a href={item.url} target="_blank" rel="noopener noreferrer" class="text-sm font-medium transition-colors hover:text-[var(--color-primary)]">
                      {item.label} ↗
                    </a>
                    {item.note && <p class="mt-2 text-xs leading-relaxed text-[var(--color-text-secondary)]">{item.note}</p>}
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </aside>
    </div>

    <p class="pt-4">
      <a href={getLocalizedPath(`/${taxEntry.data.id}/`, locale)} class="text-sm text-[var(--color-primary)] transition-colors hover:underline">
        ← {t(locale, 'back_to_category')}
      </a>
    </p>
  </article>
</Layout>
