---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import DomainListingLayout from '../../../components/DomainListingLayout.astro';

const locale = 'en';

export async function getStaticPaths() {
  const taxonomy = await getCollection('taxonomy');
  return taxonomy.map(entry => ({
    params: { l1: entry.data.id },
    props: { taxonomy: entry },
  }));
}

const { taxonomy: taxEntry } = Astro.props;
const benchmarks = await getCollection('benchmarks');
const scores = await getCollection('scores');

function summarizeText(text: string | undefined, fallback: string) {
  const normalized = (text || fallback).replace(/\s+/g, ' ').trim();
  if (normalized.length <= 190) return normalized;
  return `${normalized.slice(0, 187).trimEnd()}...`;
}

const subcategoryTabs = taxEntry.data.subcategories.map(sub => {
  const benchmarkCards = sub.benchmarks
    .map(bId => {
      const bDef = benchmarks.find(b => b.data.id === bId);
      const sData = scores.find(s => s.data.benchmark_id === bId);
      if (!bDef) return null;

      const resourceLabels = [
        ...(bDef.data.resources ?? []).map(item => item.label_en),
        ...(bDef.data.paper ? ['Paper'] : []),
        ...(!bDef.data.resources?.some(item => item.url === bDef.data.url) && bDef.data.url
          ? [bDef.data.url.includes('github.com') ? 'Code' : 'Project']
          : []),
      ].slice(0, 3);

      return {
        id: bId,
        name: bDef.data.name_en,
        description: bDef.data.description_en,
        snippet: summarizeText(bDef.data.overview_en, bDef.data.description_en),
        primaryMetric: bDef.data.metrics[0]?.name,
        focus: bDef.data.glance?.[0]?.value,
        modelCount: sData?.data.results.length ?? 0,
        resourceLabels,
        updated: sData?.data.updated,
      };
    })
    .filter(Boolean);

  return {
    id: sub.id,
    name_zh: sub.name_zh,
    name_en: sub.name_en,
    description_zh: sub.description_zh,
    description_en: sub.description_en,
    benchmarkCards,
  };
});

const domainTabs = subcategoryTabs.map(sub => ({
  id: sub.id,
  label: sub.name_en,
  description: sub.description_en,
  benchmarkCards: sub.benchmarkCards,
}));

const defaultTabId = taxEntry.data.id === 'llm' ? 'role_playing' : undefined;
---

<Layout title={taxEntry.data.name_en}>
  <DomainListingLayout
    locale={locale}
    l1Id={taxEntry.data.id}
    l1Name={taxEntry.data.name_en}
    l1Color={taxEntry.data.color}
    tabs={domainTabs}
    defaultTabId={defaultTabId}
  />
</Layout>
