---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { t, getLocaleFromUrl, getLocalizedPath, stripBasePath, withBase } from '../i18n/translations';
import type { Locale } from '../i18n/translations';

interface Props {
  title?: string;
  description?: string;
  /** Home: editorial spacing / hero classes (width matches all pages — full bleed + fluid padding) */
  editorialHome?: boolean;
  /** Benchmark paper detail: readable column width, magazine rhythm */
  benchmarkDetail?: boolean;
}

const { title, description, editorialHome = false, benchmarkDetail = false } = Astro.props;
const locale = getLocaleFromUrl(Astro.url) as Locale;
const otherLocale: Locale = locale === 'zh' ? 'en' : 'zh';
const currentPath = stripBasePath(Astro.url.pathname).replace(/^\/(zh|en)/, '') || '/';
const navSegments = currentPath.replace(/^\/+|\/+$/g, '').split('/').filter(Boolean);
const navIsHome = navSegments.length === 0;
const navIsCompare = navSegments[0] === 'compare';
const activeTaxonomyId = !navIsHome && !navIsCompare && navSegments[0] ? navSegments[0] : null;

const navLinkActive =
  'font-medium text-[var(--color-primary)] underline underline-offset-[7px] decoration-2 decoration-[var(--color-primary)]';
const navLinkIdle = 'text-[var(--color-text)] hover:text-[var(--color-primary)] transition-colors';

const pageTitle = title ? `${title} | ${t(locale, 'site_title')}` : t(locale, 'site_title');
const pageDesc = description || t(locale, 'site_slogan');

const taxonomyItems = (await getCollection('taxonomy'))
  .sort((a, b) => a.data.order - b.data.order)
  .map(item => ({
    id: item.data.id,
    name_zh: item.data.name_zh,
    name_en: item.data.name_en,
  }));
---

<!DOCTYPE html>
<html lang={locale} data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={pageDesc} />
  <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+SC:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&display=swap"
  />
  <title>{pageTitle}</title>
  <script is:inline>
    (function() {
      const saved = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const theme = saved || (prefersDark ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', theme);
    })();
  </script>
</head>
<body
  class:list={[
    'min-h-screen flex flex-col bg-[var(--color-bg)] text-[var(--color-text)]',
    'site-paper',
  ]}
>
  <header class="sticky top-0 z-[100] isolate border-b border-[var(--color-border)]/60 bg-[var(--color-bg)]">
    <nav class="mx-auto flex h-16 w-full max-w-none items-center gap-4 md:gap-6 px-4 sm:px-6 lg:px-10 xl:px-14 2xl:px-16">
      <a href={getLocalizedPath('/', locale)} class="flex shrink-0 items-center gap-2 font-bold text-xl text-[var(--color-primary)]">
        <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10" />
          <path d="M12 2a10 10 0 0 1 0 20" />
          <path d="M2 12h20" />
          <path d="M12 2c3 3.6 5 7.4 5 10s-2 6.4-5 10" />
          <path d="M12 2c-3 3.6-5 7.4-5 10s2 6.4 5 10" />
        </svg>
        Benchmark Hub
      </a>

      <div class="hidden md:flex flex-wrap items-center gap-x-5 gap-y-1 text-sm min-w-0">
        <a
          href={getLocalizedPath('/', locale)}
          class:list={['shrink-0', navIsHome ? navLinkActive : navLinkIdle]}
          aria-current={navIsHome ? 'page' : undefined}
        >
          {t(locale, 'nav_home')}
        </a>
        {taxonomyItems.map(item => {
          const active = activeTaxonomyId === item.id;
          return (
            <a
              href={getLocalizedPath(`/${item.id}/`, locale)}
              class:list={['shrink-0', active ? navLinkActive : navLinkIdle]}
              aria-current={active ? 'page' : undefined}
            >
              {locale === 'zh' ? item.name_zh : item.name_en}
            </a>
          );
        })}
        <a
          href={getLocalizedPath('/compare/', locale)}
          class:list={['shrink-0', navIsCompare ? navLinkActive : navLinkIdle]}
          aria-current={navIsCompare ? 'page' : undefined}
        >
          {t(locale, 'nav_compare')}
        </a>
      </div>

      <div class="flex shrink-0 items-center gap-3 ml-auto">
        <a
          href={getLocalizedPath(currentPath || '/', otherLocale)}
          class="px-3 py-1.5 text-sm rounded-lg border border-[var(--color-border)] hover:border-[var(--color-primary)] transition-colors"
        >
          {locale === 'zh' ? 'EN' : '中文'}
        </a>

        <button
          id="theme-toggle"
          class="p-2 rounded-lg border border-[var(--color-border)] hover:border-[var(--color-primary)] transition-colors"
          aria-label="Toggle theme"
        >
          <svg class="w-5 h-5 dark-icon hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="5" />
            <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" />
          </svg>
          <svg class="w-5 h-5 light-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
          </svg>
        </button>

        <button id="mobile-menu-btn" class="md:hidden p-2 rounded-lg border border-[var(--color-border)]">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 12h18M3 6h18M3 18h18" />
          </svg>
        </button>
      </div>
    </nav>

    <div id="mobile-menu" class="hidden md:hidden border-t border-[var(--color-border)] pb-4">
      <div class="mx-auto flex w-full max-w-none flex-col gap-2 px-4 pt-2 sm:px-6 lg:px-10 xl:px-14 2xl:px-16">
        <a
          href={getLocalizedPath('/', locale)}
          class:list={[
            'py-2 px-3 rounded-lg',
            navIsHome
              ? 'bg-[var(--color-bg-secondary)] font-medium text-[var(--color-primary)] underline underline-offset-4 decoration-2 decoration-[var(--color-primary)]'
              : 'hover:bg-[var(--color-bg-secondary)]',
          ]}
          aria-current={navIsHome ? 'page' : undefined}
        >
          {t(locale, 'nav_home')}
        </a>
        {taxonomyItems.map(item => {
          const active = activeTaxonomyId === item.id;
          return (
            <a
              href={getLocalizedPath(`/${item.id}/`, locale)}
              class:list={[
                'py-2 px-3 rounded-lg',
                active
                  ? 'bg-[var(--color-bg-secondary)] font-medium text-[var(--color-primary)] underline underline-offset-4 decoration-2 decoration-[var(--color-primary)]'
                  : 'hover:bg-[var(--color-bg-secondary)]',
              ]}
              aria-current={active ? 'page' : undefined}
            >
              {locale === 'zh' ? item.name_zh : item.name_en}
            </a>
          );
        })}
        <a
          href={getLocalizedPath('/compare/', locale)}
          class:list={[
            'py-2 px-3 rounded-lg',
            navIsCompare
              ? 'bg-[var(--color-bg-secondary)] font-medium text-[var(--color-primary)] underline underline-offset-4 decoration-2 decoration-[var(--color-primary)]'
              : 'hover:bg-[var(--color-bg-secondary)]',
          ]}
          aria-current={navIsCompare ? 'page' : undefined}
        >
          {t(locale, 'nav_compare')}
        </a>
      </div>
    </div>
  </header>

  <main
    class:list={[
      /* z-0 + isolate: keep transform/transition layers (e.g. domain turntable) below sibling header during animation */
      'relative z-0 isolate flex-1 w-full',
      editorialHome
        ? 'home-editorial-main mx-auto w-full max-w-none px-5 py-10 sm:px-8 sm:py-14 lg:px-10 lg:py-14 xl:px-14 2xl:px-16'
        : benchmarkDetail
          ? 'benchmark-article-wrap mx-auto w-full max-w-5xl px-4 py-10 sm:px-6 sm:py-12 lg:px-8 lg:py-14'
          : 'mx-auto w-full max-w-none px-4 py-8 sm:px-6 lg:px-10 xl:px-14 2xl:px-16',
    ]}
  >
    <slot />
  </main>

  <footer class="border-t border-[var(--color-border)]/40 mt-8">
    <div class="mx-auto w-full max-w-none px-4 py-8 sm:px-6 lg:px-10 xl:px-14 2xl:px-16">
      <div class="flex flex-col md:flex-row justify-between items-start gap-6">
        <div class="max-w-md">
          <h3 class="font-bold text-lg mb-2">Benchmark Hub</h3>
          <p class="text-sm text-[var(--color-text-secondary)]">{t(locale, 'footer_desc')}</p>
        </div>
        <div class="text-sm text-[var(--color-text-secondary)]">
          <p>{t(locale, 'footer_data_updated')}: 2026-04-15</p>
          <p class="mt-1">&copy; 2026 Benchmark Hub</p>
        </div>
      </div>
    </div>
  </footer>

  <script is:inline>
    document.getElementById('theme-toggle')?.addEventListener('click', () => {
      const current = document.documentElement.getAttribute('data-theme');
      const next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
      updateThemeIcons(next);
    });

    function updateThemeIcons(theme) {
      const darkIcon = document.querySelector('.dark-icon');
      const lightIcon = document.querySelector('.light-icon');
      if (theme === 'dark') {
        darkIcon?.classList.remove('hidden');
        lightIcon?.classList.add('hidden');
      } else {
        darkIcon?.classList.add('hidden');
        lightIcon?.classList.remove('hidden');
      }
    }
    updateThemeIcons(document.documentElement.getAttribute('data-theme') || 'light');

    document.getElementById('mobile-menu-btn')?.addEventListener('click', () => {
      document.getElementById('mobile-menu')?.classList.toggle('hidden');
    });
  </script>
</body>
</html>
